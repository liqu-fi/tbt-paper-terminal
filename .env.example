# Backend the reference points at. Both prod and staging live on MegaETH testnet
# (chainId 6343, taken from the SDK); DEPLOY_ENV is what selects the contract set.
VITE_DEPLOY_ENV=staging
# Public order-gateway base URL — INCLUDE the API version path (e.g. .../v1): the SDK
# appends bare routes like /markets and /sse, so the version prefix must live in this URL.
# No trailing slash. The gateway must allow CORS from this SPA's origin.
VITE_GATEWAY_URL=https://your-gateway.example.com/v1
# Optional. Defaults to the RPC the SDK knows for the chain; hermetic e2e overrides it.
# VITE_RPC_URL=https://carrot.megaeth.com/rpc
# Optional. Не коннектор wagmi: это WalletConnect ВНУТРИ Turnkey — вход
# подписью кошелька с телефона по QR. Оставьте пустым, и Turnkey всё равно
# пускает по коду на почту.
VITE_WALLETCONNECT_PROJECT_ID=

# Вход — только через Turnkey (код на почту или подпись внешнего кошелька,
# торговля со встроенного кошелька в TEE), поэтому org-id и
# auth-proxy-config-id из дашборда Turnkey (раздел Wallet Kit) ОБЯЗАТЕЛЬНЫ:
# без них экран входа объясняет, чего не хватает, и войти нельзя.
VITE_TURNKEY_ORG_ID=
VITE_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Optional override (defaults to Turnkey's hosted proxy):
# VITE_TURNKEY_AUTH_PROXY_URL=https://authproxy.turnkey.com

# Optional. Сессионные ключи (1-click) в анклаве Turnkey. Выключен: каждый
# ордер подписывается попапом кошелька. Включён: подписывает анклав.
# VITE_TURNKEY_SESSION=true
